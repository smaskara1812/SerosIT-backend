# Copy this file to .env and fill in real values. .env is gitignored.

# ── Database engine toggle ──────────────────────────────────────────────
# "mysql" for local/dev, "mssql" once ready to point at SQL Server.
# Everything else about the app is identical either way — this is the
# only thing that needs to change to move environments.
DB_ENGINE=mysql

# MySQL (dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=serosit
MYSQL_USER=root
MYSQL_PASSWORD=

# SQL Server (prod, once DB_ENGINE=mssql)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=SerosIT
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated, no wildcards. Only needed while frontend and backend
# run on separate origins (dev without the Vite proxy, or an interim
# deploy before the frontend build moves into Django's static files).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Copy this file to .env and fill in real values. .env is gitignored.

# ── Database engine toggle ──────────────────────────────────────────────
# "mysql" for local/dev, "mssql" once ready to point at SQL Server.
# Everything else about the app is identical either way — this is the
# only thing that needs to change to move environments.
DB_ENGINE=mysql

# MySQL (dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=serosit
MYSQL_USER=root
MYSQL_PASSWORD=

# SQL Server (prod, once DB_ENGINE=mssql)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=SerosIT
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated, no wildcards. Only needed while frontend and backend
# run on separate origins (dev without the Vite proxy, or an interim
# deploy before the frontend build moves into Django's static files).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_USE_CONSOLE=True prints every outgoing mail to the terminal running
# the backend instead of sending it — safe default for dev. Set to False and
# fill in the SMTP fields below to send for real.
#
# EMAIL_HOST_USER/PASSWORD/DEFAULT_FROM_EMAIL below are the shared
# "Oilfield Services" fallback account (Mst_Business_System,
# Business_System_id=6) — only used when a per-user send (authenticated as
# whoever performed the action, via their cached login password) is
# unavailable or fails. The relay itself needs no auth for internal
# recipients, but requires it (and enforces From matching whoever
# authenticated) for external ones — confirmed against the real server.
EMAIL_USE_CONSOLE=True
EMAIL_HOST=email.essar.com
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=eosil.autoalerts@essar.com

# ── Security (see documents/security/security_settings.md) ──────────────────────────────
# Key(s) that encrypt stored mail passwords: a Fernet key. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys, comma separated: the first encrypts, all decrypt (to replace a key, put the new one first, run
# `python manage.py encrypt_stored_secrets --apply --rotate`, then remove the old one). Keep it out of the source and the database.
CREDENTIAL_KEY=
# The reverse proxy's address(es), comma separated (networks allowed). REQUIRED behind a proxy: without it every user looks like one address
# to the sign-in throttle. Empty when there is no proxy.
TRUSTED_PROXIES=
IDLE_TIMEOUT_MINUTES=30
# True in production: refuse a sign-in that is not encrypted by the sign-in form.
LOGIN_REQUIRE_ENCRYPTED=False
# LOGIN_PRIVATE_KEY_FILE=

# ── Scheduled mails (the Birthday Mailer and other automatic mails) ──
# The birthday mail's own sending account. Leave BIRTHDAY_EMAIL_HOST empty to use the default account (EMAIL_HOST...) for it. If this account
# fails, the default one is used straight away. The password lives here only, never in the database or on a page.
BIRTHDAY_EMAIL_HOST=
BIRTHDAY_EMAIL_PORT=25
BIRTHDAY_EMAIL_USER=
BIRTHDAY_EMAIL_PASSWORD=
BIRTHDAY_EMAIL_USE_TLS=False
BIRTHDAY_EMAIL_USE_SSL=False
BIRTHDAY_EMAIL_FROM=
# How often the scheduler runs: at the top of every hour and then every this many minutes. Use 5, 10, 15, 20, 30 or 60 (anything else is read as 30). With 30 it runs at :00 and :30.
SCHEDULER_INTERVAL_MINUTES=30
# How many more times a failed automatic mail is tried (at most one try an hour) after the first try.
SCHEDULER_MAX_RETRIES=2

# Who is told when an automatic mail has finally failed (comma separated). Sent through the default account.
SCHEDULER_ERROR_MAIL_TO=it@seros.co.in
# The Daily Mail Summary: one mail a day listing every mail the system sent (type, sent from, sent at, status). These are the backup values; once someone saves
# Admin > Mail Summary, the page wins. MAIL_SUMMARY_TO empty = the people in SCHEDULER_ERROR_MAIL_TO. MAIL_SUMMARY_TIME is HH:MM (the scheduler runs hourly, so it
# goes at the first run at or after that time).
MAIL_SUMMARY=False
MAIL_SUMMARY_TO=
MAIL_SUMMARY_TIME=22:00
# Log files (scheduler, automation errors, django): a folder (default: backend/logs) and how many days to keep them.
LOG_DIR=
LOG_KEEP_DAYS=60

# Scheduler health. service = the scheduler stays running (heartbeat every minute); task = Windows Task Scheduler runs it once an hour.
SCHEDULER_MODE=service
# The watchdog (manage.py check_scheduler_health, run every 15 minutes) e-mails SCHEDULER_ERROR_MAIL_TO only when this is True. Keep it False on a development machine.
SCHEDULER_HEALTH_ALERTS=False
# No heartbeat for this many minutes means the service has stopped; a mail due this many hours ago and not sent is a problem; 0 = no reminder mails for a problem that goes on.
SCHEDULER_STALE_MINUTES=10
SCHEDULER_OVERDUE_HOURS=2
SCHEDULER_HEALTH_REMINDER_HOURS=0

# Mail redirect, for a test / staging / UAT machine. With MAIL_REDIRECT=True EVERY mail the application sends goes only to MAIL_REDIRECT_TO (comma separated),
# whoever the recipients are in the data; the mail's subject starts with [Redirected] and its body says who it was meant for. On with MAIL_REDIRECT_TO empty:
# nothing is sent at all. Keep it False in production.
MAIL_REDIRECT=False
MAIL_REDIRECT_TO=

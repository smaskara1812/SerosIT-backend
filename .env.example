# Copy this file to .env and fill in real values. .env is gitignored.

# ── Database engine toggle ──────────────────────────────────────────────
# "mysql" for local/dev, "mssql" once ready to point at SQL Server.
# Everything else about the app is identical either way — this is the
# only thing that needs to change to move environments.
DB_ENGINE=mysql

# MySQL (dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=serosit
MYSQL_USER=root
MYSQL_PASSWORD=

# SQL Server (prod, once DB_ENGINE=mssql)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=SerosIT
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated, no wildcards. Only needed while frontend and backend
# run on separate origins (dev without the Vite proxy, or an interim
# deploy before the frontend build moves into Django's static files).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_USE_CONSOLE=True prints every outgoing mail to the terminal running
# the backend instead of sending it — safe default for dev. Set to False and
# fill in the SMTP fields below to send for real.
EMAIL_USE_CONSOLE=True
EMAIL_HOST=email.essar.com
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@seros.in
